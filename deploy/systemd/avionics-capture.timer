[Unit]
Description=Start a Stratux capture shortly after boot
Documentation=file:///opt/avionics/README.md

[Timer]
# One minute: long enough to be past the boot itself, short enough to catch the GPS acquiring.
#
# This started at five minutes, on the reasoning that a u-blox cold start takes a while to reach a
# 3D fix and a capture beginning before that would miss it. That reasoning does not survive the
# capture being half an hour long — the fix lands inside the recording either way, and starting
# earlier means the *acquisition itself* is on record. Time to first fix is one of the things worth
# knowing about this box, and it can only be measured from a session that was already running when
# it happened. The cost is a minute or so of near-empty frames at the front.
OnBootSec=1min
AccuracySec=10s

# Deliberately not Persistent=. This fires once per boot, which matches how it is used: power the
# Pi up outside, let it record, bring it back. A missed run should not be made up on the next boot
# indoors, where there is nothing to see.
Persistent=false

[Install]
WantedBy=timers.target
